# Copy to .env, fill in, then: chmod 600 .env

# --- required ---

# Linear → Settings → Account → Security and access → Personal API keys
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret shown when you create the webhook in Linear → Settings → API → Webhooks
LINEAR_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Your own Linear user id. Only label additions by this user arm a job.
# Get it with: LINEAR_API_KEY=... node --experimental-strip-types src/whoami.ts
LINEAR_ACTOR_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- needed from checkpoint 2 onward ---

# Fine-grained PAT scoped to ChristianBell1995/Nextjs only.
# Permissions: Contents = read and write, Pull requests = read and write.
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# --- optional, defaults shown ---

# PORT=3939
# CLAUDE_LABEL=claude
# RUNNING_LABEL=claude-running
# FAILED_LABEL=claude-failed
# REPO_PATH=/Users/christianbell/code/ChristianBell1995/my-app
# REPO_SLUG=ChristianBell1995/Nextjs
# BASE_BRANCH=main
# CLAUDE_MODEL=sonnet
# CLAUDE_EFFORT=medium
# MAX_BUDGET_USD=4

# CLAUDE_STUB=1 writes a placeholder file instead of invoking the model, so the
# git and PR chain can be exercised without spending tokens. Prefer `npm run stub`.
# CLAUDE_STUB=0
